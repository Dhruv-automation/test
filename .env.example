# Instagram App ID is public configuration, not a secret.
INSTAGRAM_APP_ID=

# Register this exact URI in the Meta App Dashboard.
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/auth/meta/callback

# Start with read-only basic access. Add further scopes only when needed and approved.
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic

# Current Meta documentation version checked for this implementation.
INSTAGRAM_API_VERSION=v27.0

# OpenAI model configuration. Store OPENAI_API_KEY in Windows Credential Manager.
OPENAI_MODEL=gpt-6.2-astra
